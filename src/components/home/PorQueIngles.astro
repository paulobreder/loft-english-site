---
/**
 * "Por que aprender inglês?" — benefícios do IDIOMA (afirmações gerais),
 * sem prometer resultados ou atributos da Loft English.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../icons';
import { url } from '../../lib/url';

const itens: { icon: IconName; titulo: string; texto: string }[] = [
  { icon: 'plane', titulo: 'Viajar com mais autonomia', texto: 'Pedir informações, fazer amizades e aproveitar cada destino com mais tranquilidade.' },
  { icon: 'graduation-cap', titulo: 'Ampliar os estudos', texto: 'Ter acesso a mais cursos, intercâmbios, livros e materiais publicados em inglês.' },
  { icon: 'briefcase', titulo: 'Crescer na carreira', texto: 'O inglês está presente em muitas profissões e processos seletivos, em diversas áreas.' },
  { icon: 'clapperboard', titulo: 'Filmes, séries e músicas', texto: 'Entender o conteúdo no idioma original e aproveitar cada detalhe, sem depender da legenda.' },
  { icon: 'monitor', titulo: 'Internet sem fronteiras', texto: 'Boa parte do conteúdo de tecnologia, ciência e informação na internet é publicada em inglês.' },
  { icon: 'messages-square', titulo: 'Conectar-se com o mundo', texto: 'Conversar com pessoas de outros países e culturas, pessoalmente ou on-line.' },
];
---

<section class="section porque" aria-labelledby="porque-title">
  <div class="container">
    <div class="porque__head">
      <div class="section-head">
        <p class="eyebrow">Por que aprender inglês?</p>
        <h2 id="porque-title">Um idioma que abre portas em todas as fases.</h2>
      </div>
      <p class="lead">Da escola ao trabalho, das viagens ao entretenimento: o inglês está presente em muitos momentos da vida.</p>
    </div>

    <ul class="porque__grid">
      {
        itens.map((i) => (
          <li class="beneficio">
            <span class="beneficio__icon">
              <Icon name={i.icon} size={24} />
            </span>
            <h3>{i.titulo}</h3>
            <p>{i.texto}</p>
          </li>
        ))
      }
    </ul>

    <a class="arrow-link porque__link" href={url('/cursos/')}>
      Encontre o curso para a sua fase <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>

<style>
  .porque {
    padding-top: 0;
  }

  .porque__head {
    display: grid;
    gap: var(--sp-4);
    margin-bottom: clamp(var(--sp-7), 2rem + 2vw, var(--sp-9));
  }

  .porque__head .section-head {
    margin-bottom: 0;
  }

  .porque__grid {
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--r-xl);
    overflow: hidden;
  }

  .beneficio {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    background: var(--color-surface);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .beneficio:hover {
    background: var(--color-surface-alt);
  }

  .beneficio__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--sp-2);
    border-radius: var(--r-md);
    background: var(--color-surface-alt);
    color: var(--brand-red);
  }

  .beneficio:hover .beneficio__icon {
    background: var(--color-surface);
  }

  .beneficio h3 {
    font-size: var(--fs-md);
    font-weight: 700;
  }

  .beneficio p {
    color: var(--color-muted);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  .porque__link {
    margin-top: var(--sp-6);
  }

  .porque__link :global(svg) {
    color: var(--brand-red);
  }

  @media (min-width: 40rem) {
    .porque__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .porque__head {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
      gap: var(--sp-9);
    }

    .porque__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
